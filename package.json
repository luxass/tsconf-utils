{
  "name": "tsconf-utils",
  "version": "3.0.1",
  "description": "Utils for TSConfig files",
  "keywords": [
    "config",
    "resolve",
    "tsconfig",
    "tsconfig.json"
  ],
  "homepage": "https://github.com/luxass/tsconf-utils",
  "bugs": {
    "url": "https://github.com/luxass/tsconf-utils/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Norgaard",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/tsconf-utils.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "vitest --project unit",
    "test": "vitest --run --project unit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test:conformance": "vitest --run --project \"conformance:*\""
  },
  "dependencies": {
    "effect": "catalog:runtime",
    "jsonc-parse": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "tsc-rs": "catalog:test",
    "tsc-ts": "catalog:test",
    "tsdown": "catalog:dev",
    "tsrs": "catalog:test",
    "typescript": "catalog:dev",
    "typescript-5": "catalog:test",
    "typescript-6": "catalog:test",
    "typescript-7.1": "catalog:test",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.22.0"
}
